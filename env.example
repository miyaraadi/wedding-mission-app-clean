# Server
PORT=3000

# Admin page login (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

# Google Drive OAuth (fill these in after creating an OAuth Client ID
# of type "Web application" in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Obtained once by visiting /auth/google as the wedding Google account,
# after deployment. Leave empty until then.
GOOGLE_REFRESH_TOKEN=

# Optional: a specific Drive folder ID to upload into
GOOGLE_DRIVE_FOLDER_ID=
